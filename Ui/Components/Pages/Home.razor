@page "/"

<PageTitle>Home</PageTitle>

<h1>Welcome</h1>

<p>A simple Blazor UI for the .NET API template.</p>

<div class="card" style="max-width: 30rem;">
    <div class="card-body">
        <h5 class="card-title">Getting started</h5>
        <ul class="mb-0">
            <li>API runs on <code>http://localhost:60000</code></li>
            <li>Swagger UI at <a href="http://localhost:60000">localhost:60000</a></li>
            <li>Health check at <code>/health</code></li>
            <li>Browse <a href="users">Users</a> to see data from the API</li>
        </ul>
    </div>
</div>
